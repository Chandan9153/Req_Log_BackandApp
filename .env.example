# ========================================================
# Database & Application Environment Variables
# ========================================================

# MySQL Database URL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/user_auth_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Database Username
SPRING_DATASOURCE_USERNAME=root

# MySQL Database Password
SPRING_DATASOURCE_PASSWORD=

# Application Server Port (default 8080)
PORT=8080

# Active Spring Profile (default: mysql)
SPRING_PROFILES_ACTIVE=mysql
